<?xml version="1.0" encoding="utf-8"?>
<!-- The translator and launcher restore their NuGet packages (YamlDotNet, Tomlyn, ...) from nuget.org
     only, whatever package sources the machine's own NuGet.Config lists or leaves out (a .NET SDK
     set up without the nuget.org source failed the build with NU1100, issue 18). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
